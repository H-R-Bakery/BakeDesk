{% extends 'base.html.twig' %}

{% block title %}Order {{ order.orderNumber }} | BakeDesk{% endblock %}

{% block body %}
    {% set status_labels = {open: 'Open', completed: 'Completed', cancelled: 'Cancelled'} %}
    {% set print_status_labels = {queued: 'Queued', processing: 'Rendering', rendered: 'Rendered', submitted: 'Sent to printer', completed: 'Completed', failed: 'Failed', cancelled: 'Cancelled'} %}
    <div data-controller="mercure-status" data-mercure-status-subscription-url-value="{{ mercure('bakedesk:order:' ~ order.id) }}" data-mercure-status-order-id-value="{{ order.id }}">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <p class="text-body-secondary mb-1"><a href="{{ path('order_index') }}">Orders</a></p>
            <h1 class="h2 mb-0">Order {{ order.orderNumber }}</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            {% if order.status.value == 'open' %}
                <a class="btn btn-outline-primary" href="{{ path('order_edit', {id: order.id}) }}">Edit order</a>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancel-order-modal">
                    Cancel order
                </button>
            {% endif %}
            <a class="btn btn-primary" href="{{ path('order_new') }}">New order</a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">{{ order.customerName }}<br><span class="text-body-secondary">{{ order.customerPhone|phone_number_format('NATIONAL') }}</span></dd>
                <dt class="col-sm-3">Pickup</dt>
                <dd class="col-sm-9">{{ order.pickupAt|date('D, M j, Y g:i A', bakery_timezone) }}</dd>
                <dt class="col-sm-3">Taken by</dt>
                <dd class="col-sm-9">{{ order.user.name }}</dd>
                <dt class="col-sm-3">Ordered at</dt>
                <dd class="col-sm-9">{{ order.orderedAt|date('D, M j, Y g:i A', bakery_timezone) }}</dd>
                <dt class="col-sm-3">Payment</dt>
                <dd class="col-sm-9"><span data-order-id="{{ order.id }}" data-role="paid-status" class="badge text-bg-{{ order.paid ? 'success' : 'secondary' }}">{{ order.paid ? 'Paid' : 'Not Paid' }}</span></dd>
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><span data-order-id="{{ order.id }}" data-role="order-status" class="badge text-bg-{{ order.status.value == 'open' ? 'primary' : (order.status.value == 'completed' ? 'success' : 'danger') }}">{{ status_labels[order.status.value] }}</span></dd>
                {% if order.notes %}
                    <dt class="col-sm-3">Notes</dt>
                    <dd class="col-sm-9">{{ order.notes }}</dd>
                {% endif %}
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <h2 class="h5 mb-0">Labels</h2>
                {% if order.status.value in ['open', 'completed'] and package_allocations is not empty %}
                    <form method="post" action="{{ path('order_labels_reprint', {id: order.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('reprint-all-labels-' ~ order.id) }}">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Reprint all labels</button>
                    </form>
                {% endif %}
            </div>
            {% if packaging_error %}
                <p class="alert alert-warning mb-0">{{ packaging_error }}</p>
            {% elseif package_allocations is empty %}
                <p class="text-body-secondary mb-0">No package labels are available.</p>
            {% else %}
                <div class="list-group">
                    {% for allocation in package_allocations %}
                        {% set package_key = allocation.orderItem.id ~ ':' ~ allocation.packageNumber %}
                        {% set print_job = latest_label_jobs[package_key] ?? null %}
                        <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-3">
                            <div>
                                <strong>{{ allocation.orderItem.productType.name }}</strong>
                                — {{ allocation.quantity }} {{ allocation.unit.name }}
                                {% if allocation.packageCount > 1 %}
                                    — Box {{ allocation.packageNumber }} of {{ allocation.packageCount }}
                                {% endif %}
                                <div class="mt-1">
                                    {% if print_job %}
                                        <span class="text-body-secondary">Status:</span>
                                        <span data-role="package-print-status" data-order-item-id="{{ allocation.orderItem.id }}" data-package-number="{{ allocation.packageNumber }}" data-print-job-id="{{ print_job.id }}" class="d-inline-flex align-items-center gap-2">
                                            <span data-role="print-status" class="badge text-bg-{{ print_job.status.value == 'failed' ? 'danger' : (print_job.status.value == 'completed' ? 'success' : 'secondary') }}">{{ print_status_labels[print_job.status.value] }}</span>
                                            <span data-role="print-error" class="text-body-secondary ms-2"{% if print_job.status.value != 'failed' or not print_job.errorMessage %} hidden{% endif %}>{{ print_job.errorMessage ?? '' }}</span>
                                        </span>
                                    {% else %}
                                        <span data-role="package-print-status" data-order-item-id="{{ allocation.orderItem.id }}" data-package-number="{{ allocation.packageNumber }}" data-print-job-id="" class="d-inline-flex align-items-center gap-2">
                                            <span data-role="print-status" class="badge text-bg-secondary">Not queued</span>
                                            <span data-role="print-error" class="text-body-secondary ms-2" hidden></span>
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('order_label_package', {id: order.id, itemId: allocation.orderItem.id, packageNumber: allocation.packageNumber}) }}" target="_blank" rel="noopener">Preview</a>
                                {% if order.status.value in ['open', 'completed'] %}
                                    <form method="post" action="{{ path('order_label_package_reprint', {id: order.id, itemId: allocation.orderItem.id, packageNumber: allocation.packageNumber}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reprint-package-label-' ~ order.id ~ '-' ~ allocation.orderItem.id ~ '-' ~ allocation.packageNumber) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Reprint</button>
                                    </form>
                                    {% if print_job and print_job.documentType.value == 'label' and print_job.status.value == 'failed' %}
                                        <form method="post" action="{{ path('order_print_job_retry', {id: order.id, printJobId: print_job.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('retry-print-job-' ~ print_job.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Retry</button>
                                        </form>
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5">Items</h2>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Quantity</th><th>Unit</th><th>Product type</th><th>Description</th></tr>
                    </thead>
                    <tbody>
                        {% for item in order.items %}
                            <tr>
                                <td>{{ item.quantity }}</td>
                                <td>{{ item.unit.name }}</td>
                                <td>{{ item.productType.name }}</td>
                                <td>{{ item.description }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {% if order.status.value == 'open' %}
        <div class="modal fade" id="cancel-order-modal" tabindex="-1" aria-labelledby="cancel-order-modal-label" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="cancel-order-modal-label">Cancel Order #{{ order.orderNumber }}?</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        This keeps the order in history but removes it from active upcoming orders.
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Keep order</button>
                        <form method="post" action="{{ path('order_cancel', {id: order.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('cancel-order-' ~ order.id) }}">
                            <button type="submit" class="btn btn-danger">Cancel order</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
    </div>
{% endblock %}
