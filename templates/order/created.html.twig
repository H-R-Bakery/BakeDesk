{% extends 'base.html.twig' %}

{% block title %}Order {{ order.orderNumber }} | BakeDesk{% endblock %}

{% block body %}
    {% set print_status_labels = {queued: 'Queued', processing: 'Rendering', rendered: 'Rendered', submitted: 'Sent to printer', completed: 'Completed', failed: 'Failed', cancelled: 'Cancelled'} %}
    <div data-controller="mercure-status" data-mercure-status-subscription-url-value="{{ mercure('bakedesk:order:' ~ order.id) }}" data-mercure-status-order-id-value="{{ order.id }}">
    <div class="card shadow-sm">
        <div class="card-body">
            <p class="text-success fw-semibold mb-2">Order saved</p>
            <h1 class="h2 mb-4">Order {{ order.orderNumber }}</h1>

            <dl class="row mb-4">
                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9">{{ order.customerName }}<br><span class="text-body-secondary">{{ order.customerPhone|phone_number_format('NATIONAL') }}</span></dd>
                <dt class="col-sm-3">Pickup</dt>
                <dd class="col-sm-9">{{ order.pickupAt|date('F j, Y g:i A', bakery_timezone) }}</dd>
                <dt class="col-sm-3">Payment</dt>
                <dd class="col-sm-9">{{ order.paid ? 'Paid' : 'Not paid' }}</dd>
                {% if order.notes %}
                    <dt class="col-sm-3">Notes</dt>
                    <dd class="col-sm-9">{{ order.notes }}</dd>
                {% endif %}
            </dl>

            <h2 class="h5">Items</h2>
            <ul class="list-group mb-4">
                {% for item in order.items %}
                    <li class="list-group-item">
                        <strong>{{ item.quantity }} {{ item.unit.name }} {{ item.productType.name }}</strong>
                        <span class="text-body-secondary">&mdash; {{ item.description }}</span>
                    </li>
                {% endfor %}
            </ul>

            <h2 class="h5">Labels</h2>
            {% if packaging_error %}
                <p class="alert alert-warning">{{ packaging_error }}</p>
            {% elseif package_allocations is empty %}
                <p class="text-body-secondary">No package labels were queued.</p>
            {% else %}
                <div class="list-group mb-4">
                    {% for allocation in package_allocations %}
                        {% set package_key = allocation.orderItem.id ~ ':' ~ allocation.packageNumber %}
                        {% set print_job = latest_label_jobs[package_key] ?? null %}
                        <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
                            <span>
                                <strong>{{ allocation.orderItem.productType.name }}</strong>
                                {% if allocation.packageCount > 1 %} — Box {{ allocation.packageNumber }} of {{ allocation.packageCount }}{% endif %}
                            </span>
                            {% if print_job %}
                                <span data-role="package-print-status" data-order-item-id="{{ allocation.orderItem.id }}" data-package-number="{{ allocation.packageNumber }}" data-print-job-id="{{ print_job.id }}">
                                    <span data-role="print-status" class="badge text-bg-{{ print_job.status.value == 'failed' ? 'danger' : (print_job.status.value == 'completed' ? 'success' : 'secondary') }}">{{ print_status_labels[print_job.status.value] }}</span>
                                    <span data-role="print-error" class="text-body-secondary ms-2"{% if print_job.status.value != 'failed' or not print_job.errorMessage %} hidden{% endif %}>{{ print_job.errorMessage ?? '' }}</span>
                                </span>
                            {% else %}
                                <span data-role="package-print-status" data-order-item-id="{{ allocation.orderItem.id }}" data-package-number="{{ allocation.packageNumber }}" data-print-job-id="">
                                    <span data-role="print-status" class="badge text-bg-secondary">Not queued</span>
                                    <span data-role="print-error" class="text-body-secondary ms-2" hidden></span>
                                </span>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="{{ path('order_detail', {id: order.id}) }}">View order</a>
                <a class="btn btn-outline-primary" href="{{ path('order_new') }}">Enter another order</a>
            </div>
        </div>
    </div>
    </div>
{% endblock %}
