<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <style>
        @page { size: Letter; margin: 0.65in; }
        * { box-sizing: border-box; }
        body { color: #000; background: #fff; font-family: Arial, Helvetica, sans-serif; }
        main { border: 2px solid #000; min-height: 9.7in; padding: 0.55in; }
        .logo { height: 0.65in; }
        .logo svg { max-width: 3.2in; max-height: 0.65in; }
        h1, h2, p { margin: 0; }
        h1 { font-size: 24pt; margin-top: 0.2in; }
        h2 { border-bottom: 2px solid #000; font-size: 18pt; margin: 0.6in 0 0.35in; padding-bottom: 0.12in; }
        .details { font-size: 14pt; line-height: 1.6; }
        .details strong { display: inline-block; min-width: 1.1in; }
        .message { font-size: 16pt; margin-top: 0.8in; }
    </style>
</head>
<body>
<main>
    <div class="logo" aria-label="{{ bakery_brand_name }} logo">{{ logo_svg|raw }}</div>
    <h1>{{ bakery_brand_name }} · {{ bakedesk_brand_name }}</h1>
    <h2>REPORT PRINTER TEST</h2>
    <div class="details">
        <p><strong>Printer:</strong> {{ printer.name }}</p>
        <p><strong>Date/Time:</strong> {{ generated_at|date('M j, Y g:i A', bakery_timezone) }}</p>
    </div>
    <p class="message">This page verifies PDF report printing.</p>
</main>
</body>
</html>
