{% extends 'base.html.twig' %}

{% block title %}{{ customer.name }} | {{ bakedesk_brand_name }}{% endblock %}

{% block body %}
    {% set status_labels = {open: 'Open', completed: 'Completed', cancelled: 'Cancelled'} %}
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <nav aria-label="Breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="{{ path('customer_index') }}">Customers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ customer.name }}</li>
                </ol>
            </nav>
            <h1 class="h2 mb-2">{{ customer.name }}</h1>
            <p class="mb-2">{{ customer.phone|phone_number_format('NATIONAL') }}</p>
            <span class="badge text-bg-{{ customer.active ? 'success' : 'secondary' }}">{{ customer.active ? 'Active' : 'Inactive' }}</span>
        </div>
        {% if customer.active %}
            <a class="btn btn-primary" href="{{ path('order_new', {customer: customer.id}) }}">New Order for {{ customer.name }}</a>
        {% endif %}
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Order history</h2>
            {% if orders is empty %}
                <p class="text-body-secondary mb-0">No orders found for this customer.</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Order</th>
                                <th>Pickup</th>
                                <th>Customer on order</th>
                                <th>Taken by</th>
                                <th>Items</th>
                                <th>Paid</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                                <tr>
                                    <td><a class="fw-semibold" href="{{ path('order_detail', {id: order.id}) }}">{{ order.orderNumber }}</a><span class="d-block small text-body-secondary">{{ order.orderedAt|date('M j, Y g:i A', bakery_timezone) }}</span></td>
                                    <td data-sort-value="{{ order.pickupAt|date('Y-m-d H:i:s', bakery_timezone) }}">{{ order.pickupAt|date('M j, Y', bakery_timezone) }}<span class="d-block text-body-secondary">{{ order.pickupAt|date('g:i A', bakery_timezone) }}</span></td>
                                    <td>{{ order.customerName }}<span class="d-block small text-body-secondary">{{ order.customerPhone|phone_number_format('NATIONAL') }}</span></td>
                                    <td>{{ order.user.name }}</td>
                                    <td>
                                        <ul class="list-unstyled mb-0">
                                            {% for item in order.items %}
                                                <li>{{ item.quantity }} {{ item.unit.name }} {{ item.productType.name }} — {{ item.description }}</li>
                                            {% endfor %}
                                        </ul>
                                    </td>
                                    <td><span class="badge text-bg-{{ order.paid ? 'success' : 'secondary' }}">{{ order.paid ? 'Paid' : 'Not Paid' }}</span></td>
                                    <td><span class="badge text-bg-{{ order.status.value == 'open' ? 'primary' : (order.status.value == 'completed' ? 'success' : 'danger') }}">{{ status_labels[order.status.value] }}</span></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if total_pages > 1 %}
                    <nav class="mt-3" aria-label="Customer order history pages">
                        <ul class="pagination justify-content-center mb-0">
                            {% for page_number in 1..total_pages %}
                                <li class="page-item{{ page_number == page ? ' active' : '' }}">
                                    <a class="page-link" href="{{ path('customer_detail', {id: customer.id, page: page_number}) }}">{{ page_number }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    </nav>
                {% endif %}
                <p class="small text-body-secondary mt-3 mb-0">Showing {{ (page - 1) * page_size + 1 }}–{{ min(page * page_size, total) }} of {{ total }} order{{ total == 1 ? '' : 's' }}.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
