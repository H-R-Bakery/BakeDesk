{% extends 'base.html.twig' %}

{% block title %}Customers | {{ bakedesk_brand_name }}{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h2 mb-1">Customers</h1>
            <p class="text-body-secondary mb-0">Find a customer and view their order history.</p>
        </div>
    </div>

    <form method="get" action="{{ path('customer_index') }}" class="card card-body shadow-sm mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-8">
                <label class="form-label" for="customer-search">Search</label>
                <input class="form-control" id="customer-search" type="search" name="q" value="{{ query }}" placeholder="Customer name or phone">
            </div>
            <div class="col-12 col-lg-4 d-flex gap-2">
                <button class="btn btn-primary flex-grow-1" type="submit">Search</button>
                {% if query is not empty %}
                    <a class="btn btn-outline-secondary" href="{{ path('customer_index') }}">Clear</a>
                {% endif %}
            </div>
        </div>
    </form>

    {% if customers is empty %}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <p class="h5 mb-3">{{ query is empty ? 'No customers found.' : 'No customers matched your search.' }}</p>
                {% if query is not empty %}
                    <a class="btn btn-outline-secondary" href="{{ path('customer_index') }}">Clear search</a>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="table-responsive shadow-sm rounded">
            <table id="customers-table" class="table table-striped table-hover align-middle mb-0"
                   data-toggle="table" data-sortable="true" data-search="false" data-pagination="false"
                   data-mobile-responsive="true" data-classes="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th data-field="customer" data-sortable="true">Customer</th>
                        <th data-field="phone" data-sortable="true">Phone</th>
                        <th data-field="status" data-sortable="true">Status</th>
                        <th data-field="action">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for customer in customers %}
                        <tr>
                            <td><a class="fw-semibold" href="{{ path('customer_detail', {id: customer.id}) }}">{{ customer.name }}</a></td>
                            <td>{{ customer.phone|phone_number_format('NATIONAL') }}</td>
                            <td><span class="badge text-bg-{{ customer.active ? 'success' : 'secondary' }}">{{ customer.active ? 'Active' : 'Inactive' }}</span></td>
                            <td>
                                {% if customer.active %}
                                    <a class="btn btn-sm btn-primary" href="{{ path('order_new', {customer: customer.id}) }}">New Order</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if total_pages > 1 %}
            <nav class="mt-3" aria-label="Customer pages">
                <ul class="pagination justify-content-center">
                    {% for page_number in 1..total_pages %}
                        <li class="page-item{{ page_number == page ? ' active' : '' }}">
                            <a class="page-link" href="{{ path('customer_index', app.request.query.all|merge({page: page_number})) }}">{{ page_number }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}
        <p class="small text-body-secondary mt-2">Showing {{ (page - 1) * page_size + 1 }}–{{ min(page * page_size, total) }} of {{ total }} customer{{ total == 1 ? '' : 's' }}.</p>
    {% endif %}
{% endblock %}
